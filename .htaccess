# Apache Server Clean URLs Configuration (.htaccess)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 0. Redirect external requests for /index or /index.html to root /
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index(\.html)?(\?|\ ) [NC]
    RewriteRule ^index(\.html)?$ / [R=301,L]

    # 1. Redirect external requests with .html extension to clean non-.html URL
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^/]+/)*([^.]+)\.html\ HTTP/ [NC]
    RewriteRule ^(([^/]+/)*[^.]+)\.html$ /$1 [R=301,L]

    # 2. Silently rewrite clean requests to the actual .html file if present
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.*)$ $1.html [L]
</IfModule>
